{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "TexArt",
    "version": "0.1.0",
    "identifier": "com.maxpainop.texart",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://127.0.0.1:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "label": "main",
                "url": "index.html",
                "title": "TexArt",
                "resizable": true,
                "center": true,
                "decorations": false,
                "width": 802,
                "height": 507
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "fileAssociations": [
            {
                "ext": ["mxa"],
                "name": "TexArt Project",
                "description": "Editable TexArt animation project",
                "role": "Editor"
            }
        ]
    }
}
